                    <p id="header-tagline" class="text-xs text-gray-400 mt-1">Fresh • Cheesy • Fire-Baked</p>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="hidden md:flex items-center space-x-8 text-sm font-medium">
                <a href="#home" class="hover:text-brand-gold transition-colors">Home</a>
                <a href="#menu" class="hover:text-brand-gold transition-colors">Menu</a>
                <a href="#about" class="hover:text-brand-gold transition-colors">About Us</a>
                <a href="#contact" class="hover:text-brand-gold transition-colors">Contact</a>
