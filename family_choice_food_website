                <!-- Mobile Menu Button -->
                <button onclick="toggleMobileNav()" class="md:hidden text-gray-300 hover:text-brand-gold text-2xl focus:outline-none">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Drawer Navigation -->
        <div id="mobile-nav" class="hidden md:hidden bg-brand-darkBg border-b border-brand-border px-4 pt-2 pb-4 space-y-3">
            <a href="#home" onclick="toggleMobileNav()" class="block py-2 text-gray-300 hover:text-brand-gold font-medium">Home</a>
            <a href="#menu" onclick="toggleMobileNav()" class="block py-2 text-gray-300 hover:text-brand-gold font-medium">Menu</a>
            <a href="#about" onclick="toggleMobileNav()" class="block py-2 text-gray-300 hover:text-brand-gold font-medium">About Us</a>
            <a href="#contact" onclick="toggleMobileNav()" class="block py-2 text-gray-300 hover:text-brand-gold font-medium">Contact</a>
            <button onclick="openAdminModal(); toggleMobileNav();" class="block w-full text-left py-2 text-xs text-amber-500/80 hover:text-amber-400">Admin Login</button>
        </div>
    </header>

    <!-- Main Content Body -->
    <main class="flex-grow">
        
        <!-- HERO SECTION -->
        <section id="home" class="relative bg-gradient-to-b from-zinc-900 to-brand-darkBg py-16 md:py-24 border-b border-zinc-800">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <div class="space-y-6 text-center md:text-left">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-brand-gold text-xs font-semibold tracking-wider uppercase">
                        <i class="fa-solid fa-crown text-amber-400"></i> Premium Quality Fast Food
                    </div>
                    <h1 id="hero-title" class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight">
                        Welcome to <span class="text-brand-gold">Family Choice Food</span>
                    </h1>
                    <p id="hero-tagline" class="text-xl md:text-2xl font-handwritten text-amber-400 tracking-wide">
                        Fresh • Cheesy • Fire-Baked
                    </p>
                    <p id="hero-desc" class="text-gray-300 text-base md:text-lg max-w-xl mx-auto md:mx-0">
                        Delicious pizza, juicy burgers, crispy fries and fresh shawarma, made for every craving. Taste the difference in every bite!
                    </p>
                    <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4 pt-4">
                        <a href="#menu" class="w-full sm:w-auto bg-brand-gold hover:bg-amber-500 text-black font-bold px-8 py-3.5 rounded-full text-center transition-all shadow-lg gold-glow">
                            <i class="fa-solid fa-utensils mr-2"></i> Explore Menu
                        </a>
                        <button onclick="openCheckoutModal()" class="w-full sm:w-auto bg-zinc-800 hover:bg-zinc-700 text-white font-semibold px-8 py-3.5 rounded-full border border-zinc-700 transition-all text-center">
                            <i class="fa-solid fa-bag-shopping mr-2 text-brand-gold"></i> Quick Order
                        </button>
                    </div>
                </div>

                <!-- Hero Image Showcase -->
                <div class="relative flex justify-center">
                    <div class="relative w-full max-w-md aspect-square rounded-3xl overflow-hidden border-2 border-amber-500/30 shadow-2xl gold-glow-lg bg-zinc-900 flex items-center justify-center">
                        <img id="hero-image" src="https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=800&q=80" alt="Delicious Food Reference" class="w-full h-full object-cover">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                        <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl bg-black/60 backdrop-blur-md border border-white/10 text-white">
                            <p class="font-bold text-brand-gold text-lg">FCF Special Pizza</p>
                            <p class="text-xs text-gray-300">Loaded with extra cheese, chicken tikka & special house sauces.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- MENU SECTION -->
        <section id="menu" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Section Header -->
            <div class="text-center space-y-3 mb-10">
                <h2 class="text-3xl md:text-4xl font-extrabold text-brand-gold tracking-tight">Our Delicious Menu</h2>
                <p class="text-gray-400 text-sm md:text-base max-w-2xl mx-auto">Select your favorite fast-food categories and customize your size preferences.</p>
            </div>

            <!-- Menu Category Controls & Search -->
            <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-8">
                <!-- Category Tabs -->
                <div id="category-tabs" class="flex items-center gap-2 overflow-x-auto w-full md:w-auto pb-2 md:pb-0 scrollbar-none">
                    <!-- Dynamic Category Buttons Rendered Here -->
                </div>

                <!-- Search Input -->
                <div class="relative w-full md:w-72">
                    <input type="text" id="menu-search" oninput="filterMenu()" placeholder="Search menu..." class="w-full bg-brand-cardBg border border-zinc-800 rounded-full py-2.5 pl-10 pr-4 text-sm text-white focus:outline-none focus:border-brand-gold">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-gray-500 text-sm"></i>
                </div>
            </div>

            <!-- Menu Products Grid -->
            <div id="menu-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <!-- Dynamic Product Cards Injected Here -->
            </div>
        </section>

        <!-- ABOUT US SECTION -->
        <section id="about" class="py-16 bg-zinc-900/60 border-y border-zinc-800">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                    <div class="space-y-6">
                        <span class="text-brand-gold text-sm font-semibold uppercase tracking-widest">About Our Restaurant</span>
                        <h2 class="text-3xl md:text-4xl font-extrabold text-white">Crafted With Passion & Authentic Flavors</h2>
                        <p class="text-gray-300 leading-relaxed">
                            At <strong class="text-brand-gold">Family Choice Food (FCF)</strong>, we believe every meal should be a memorable experience. From our stone-baked cheesy pizzas to our sizzling zinger burgers, juicy shawarmas, and crispy loaded fries — each dish is prepared fresh using high-quality ingredients and secret house spices.
                        </p>
                        
                        <!-- Features Grid -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                            <div class="p-4 rounded-xl bg-zinc-800/60 border border-zinc-700/50">
                                <i class="fa-solid fa-fire text-amber-500 text-2xl mb-2"></i>
                                <h4 class="font-bold text-white text-base">Fire-Baked Perfection</h4>
                                <p class="text-xs text-gray-400 mt-1">Authentic high-temp ovens for crusty pizza dough.</p>
                            </div>
                            <div class="p-4 rounded-xl bg-zinc-800/60 border border-zinc-700/50">
                                <i class="fa-solid fa-leaf text-emerald-500 text-2xl mb-2"></i>
                                <h4 class="font-bold text-white text-base">100% Fresh Ingredients</h4>
                                <p class="text-xs text-gray-400 mt-1">Fresh meats, crisp veg, and signature sauces.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Visual Poster Mock / Showcase -->
                    <div class="relative rounded-2xl overflow-hidden border border-zinc-700 bg-zinc-800 p-6 shadow-2xl">
                        <div class="text-center space-y-4">
                            <div class="w-20 h-20 mx-auto rounded-full bg-amber-500/10 border border-amber-500 flex items-center justify-center text-brand-gold text-3xl">
                                <i class="fa-solid fa-utensils"></i>
                            </div>
                            <h3 class="text-2xl font-extrabold text-brand-gold">FCF Special Quality Guarantee</h3>
                            <p class="text-sm text-gray-300">
                                Designed to cater to families, parties, and fast-food lovers across town. Order online for swift home delivery or direct pickup!
                            </p>
                            <div class="pt-2 border-t border-zinc-700 flex justify-around text-center">
                                <div>
                                    <p class="text-xl font-bold text-white">100%</p>
                                    <p class="text-xs text-gray-400">Halal Certified</p>
                                </div>
                                <div>
                                    <p class="text-xl font-bold text-white">Fast</p>
                                    <p class="text-xs text-gray-400">WhatsApp Delivery</p>
                                </div>
                                <div>
                                    <p class="text-xl font-bold text-white">Hot & Fresh</p>
                                    <p class="text-xs text-gray-400">Guaranteed</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SOCIAL MEDIA LINKS SECTION -->
        <section id="social" class="py-12 bg-black border-b border-zinc-800">
            <div class="max-w-7xl mx-auto px-4 text-center">
                <h3 class="text-xl font-bold text-brand-gold mb-2">Follow Family Choice Food</h3>
                <p class="text-xs text-gray-400 mb-6">Connect with us on our official social channels for deals & updates</p>
                
                <div id="social-media-container" class="flex flex-wrap items-center justify-center gap-4">
                    <!-- Dynamic Enabled Social Links Rendered Here -->
                </div>
            </div>
        </section>

        <!-- CONTACT SECTION -->
        <section id="contact" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-extrabold text-brand-gold">Get In Touch</h2>
                <p class="text-gray-400 text-sm mt-2">Have a special order or inquiry? Reach out to us directly.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Phone / WhatsApp Box -->
                <div class="p-6 rounded-2xl bg-zinc-900 border border-zinc-800 text-center space-y-3">
                    <div class="w-12 h-12 mx-auto rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl">
                        <i class="fa-brands fa-whatsapp"></i>
                    </div>
                    <h4 class="font-bold text-white">WhatsApp Direct</h4>
                    <p id="contact-phone" class="text-amber-400 font-mono font-bold">0328-7969698</p>
                    <p class="text-xs text-gray-400">Instant order assistance & menu inquiries.</p>
                </div>

                <!-- Hours Box -->
                <div class="p-6 rounded-2xl bg-zinc-900 border border-zinc-800 text-center space-y-3">
                    <div class="w-12 h-12 mx-auto rounded-full bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl">
                        <i class="fa-regular fa-clock"></i>
                    </div>
                    <h4 class="font-bold text-white">Opening Hours</h4>
                    <p class="text-gray-300 text-sm font-medium">3:00 PM - 03:00 AM</p>
                    <p class="text-xs text-gray-400">Open 7 days a week for lunch, dinner & late night.</p>
                </div>

                <!-- Delivery Option Box -->
                <div class="p-6 rounded-2xl bg-zinc-900 border border-zinc-800 text-center space-y-3">
                    <div class="w-12 h-12 mx-auto rounded-full bg-blue-500/10 text-blue-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-truck-fast"></i>
                    </div>
                    <h4 class="font-bold text-white">Delivery & Takeaway</h4>
                    <p class="text-gray-300 text-sm">Fast Hot Delivery</p>
                    <p class="text-xs text-gray-400">Order directly to your home or neighborhood.</p>
                </div>
            </div>
        </section>

    </main>

    <!-- FLOATING WHATSAPP BUTTON -->
    <a id="floating-whatsapp-btn" href="#" target="_blank" class="fixed bottom-6 right-6 z-40 bg-emerald-500 hover:bg-emerald-400 text-white p-4 rounded-full shadow-2xl flex items-center justify-center text-2xl transition-transform hover:scale-110 gold-glow">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

    <!-- CUSTOMER SHOPPING CART MODAL / DRAWER -->
    <div id="cart-modal" class="fixed inset-0 z-50 modal-backdrop hidden flex justify-end">
        <div class="w-full max-w-md bg-brand-darkBg border-l border-zinc-800 h-full flex flex-col justify-between p-6 shadow-2xl relative animate-slide-left">
            <!-- Modal Header -->
            <div>
                <div class="flex items-center justify-between pb-4 border-b border-zinc-800">
                    <h3 class="text-xl font-bold text-brand-gold flex items-center gap-2">
                        <i class="fa-solid fa-basket-shopping"></i> Your Shopping Cart
                    </h3>
                    <button onclick="toggleCartModal()" class="text-gray-400 hover:text-white text-xl">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <!-- Cart Items Container -->
                <div id="cart-items-list" class="my-4 space-y-3 max-h-[55vh] overflow-y-auto pr-1">
                    <!-- Dynamic Cart Items Rendered Here -->
                </div>
            </div>

            <!-- Cart Footer Summary & Checkout -->
            <div class="border-t border-zinc-800 pt-4 space-y-3">
                <div class="space-y-1.5 text-sm">
                    <div class="flex justify-between text-gray-400">
                        <span>Subtotal</span>
                        <span id="cart-subtotal" class="text-white font-medium">Rs. 0</span>
                    </div>
                    <div class="flex justify-between text-gray-400">
                        <span>Delivery Fee</span>
                        <span id="cart-delivery-fee" class="text-white font-medium">Rs. 0</span>
                    </div>
                    <div class="flex justify-between text-lg font-bold text-brand-gold pt-2 border-t border-zinc-800">
                        <span>Grand Total</span>
                        <span id="cart-grand-total">Rs. 0</span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3 pt-2">
                    <button onclick="toggleCartModal()" class="py-3 bg-zinc-800 hover:bg-zinc-700 text-gray-300 font-semibold rounded-xl text-sm">
                        Continue Shopping
                    </button>
                    <button onclick="openCheckoutModal()" class="py-3 bg-brand-gold hover:bg-amber-500 text-black font-bold rounded-xl text-sm gold-glow">
                        Proceed Checkout
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- CUSTOMER CHECKOUT MODAL -->
    <div id="checkout-modal" class="fixed inset-0 z-50 modal-backdrop hidden flex items-center justify-center p-4">
        <div class="w-full max-w-lg bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between pb-3 border-b border-zinc-800">
                <h3 class="text-xl font-bold text-brand-gold flex items-center gap-2">
                    <i class="fa-solid fa-clipboard-check"></i> Complete Your Order
                </h3>
                <button onclick="closeCheckoutModal()" class="text-gray-400 hover:text-white">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form id="checkout-form" onsubmit="handleCheckoutSubmit(event)" class="space-y-4 mt-4 text-sm">
                <div>
                    <label class="block text-gray-300 mb-1 font-medium">Full Name <span class="text-red-500">*</span></label>
                    <input type="text" id="cust-name" required placeholder="e.g. Ali Ahmed" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg p-2.5 text-white focus:outline-none focus:border-brand-gold">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-gray-300 mb-1 font-medium">Mobile Number <span class="text-red-500">*</span></label>
                        <input type="tel" id="cust-phone" required placeholder="03XXXXXXXXX" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg p-2.5 text-white focus:outline-none focus:border-brand-gold">
                    </div>
                    <div>
                        <label class="block text-gray-300 mb-1 font-medium">Order Type</label>
                        <select id="cust-ordertype" onchange="toggleAddressRequirement()" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg p-2.5 text-white focus:outline-none focus:border-brand-gold">
                            <option value="Delivery">Home Delivery</option>
                            <option value="Pickup">Self Pickup</option>
                        </select>
                    </div>
                </div>

                <div id="address-block">
                    <label class="block text-gray-300 mb-1 font-medium">Complete Delivery Address <span class="text-red-500">*</span></label>
                    <textarea id="cust-address" rows="2" placeholder="House #, Street, Area / Neighborhood" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg p-2.5 text-white focus:outline-none focus:border-brand-gold"></textarea>
                </div>

                <div>
                    <label class="block text-gray-300 mb-1 font-medium">Special Delivery Instructions (Optional)</label>
                    <input type="text" id="cust-instructions" placeholder="e.g. Less spicy, ring door bell" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg p-2.5 text-white focus:outline-none focus:border-brand-gold">
                </div>

                <div>
                    <label class="block text-gray-300 mb-1 font-medium">Payment Method</label>
                    <select id="cust-payment" class="w-full bg-zinc-800 border border-zinc-700 rounded-lg p-2.5 text-white focus:outline-none focus:border-brand-gold">
                        <option value="Cash on Delivery">Cash on Delivery (COD)</option>
                        <option value="Pay at Pickup">Pay at Restaurant Pickup</option>
                    </select>
                </div>

                <!-- Order Summary Breakdown -->
                <div class="bg-black/50 p-3 rounded-xl border border-zinc-800 space-y-1 text-xs">
                    <p class="font-bold text-brand-gold mb-1 text-sm">Order Summary</p>
                    <div id="checkout-summary-items" class="space-y-1 text-gray-300">
                        <!-- Dynamic Checkout Items -->
                    </div>
                    <div class="pt-2 mt-2 border-t border-zinc-800 font-bold flex justify-between text-sm text-white">
                        <span>Total Payable</span>
                        <span id="checkout-total-amount" class="text-brand-gold">Rs. 0</span>
