        function initAddToCart(productId) {
            const item = products.find(p => p.id === productId);
            if (!item || !item.available) return;

            if (item.type === 'sized') {
                // Open Sizing Modal
                pendingSelectedItem = item;
                document.getElementById('size-item-title').innerText = item.name;
                document.getElementById('size-options-container').innerHTML = `
                    <button onclick="confirmSizedAdd('Regular', ${item.priceRegular})" class="w-full p-3 bg-zinc-800 hover:bg-amber-500 hover:text-black rounded-xl text-left flex justify-between font-bold text-sm transition-all border border-zinc-700">
                        <span>Regular Portion</span>
                        <span>Rs. ${item.priceRegular}</span>
                    </button>
                    <button onclick="confirmSizedAdd('Large', ${item.priceLarge})" class="w-full p-3 bg-zinc-800 hover:bg-amber-500 hover:text-black rounded-xl text-left flex justify-between font-bold text-sm transition-all border border-zinc-700">
                        <span>Large Portion</span>
                        <span>Rs. ${item.priceLarge}</span>
                    </button>
                `;
                document.getElementById('size-modal').classList.remove('hidden');
            } else {
                addToCart(item, 'Standard', item.price);
            }
        }

        function confirmSizedAdd(sizeName, price) {
            if (pendingSelectedItem) {
                addToCart(pendingSelectedItem, sizeName, price);
                closeSizeModal();
            }
        }

        function closeSizeModal() {
            document.getElementById('size-modal').classList.add('hidden');
            pendingSelectedItem = null;
        }

        function addToCart(product, sizeLabel, unitPrice) {
            const cartKey = `${product.id}_${sizeLabel}`;
            const existingIndex = cart.findIndex(c => c.cartKey === cartKey);

            if (existingIndex > -1) {
                cart[existingIndex].qty += 1;
            } else {
                cart.push({
                    cartKey: cartKey,
                    id: product.id,
                    name: product.name,
                    size: sizeLabel,
                    price: unitPrice,
                    qty: 1
                });
            }

            saveCart();
            updateCartUI();
            toggleCartModal(true); // Show Cart Drawer
        }

        function updateCartQty(cartKey, delta) {
            const index = cart.findIndex(c => c.cartKey === cartKey);
            if (index > -1) {
                cart[index].qty += delta;
                if (cart[index].qty <= 0) {
                    cart.splice(index, 1);
                }
            }
            saveCart();
            updateCartUI();
        }

        function saveCart() {
            localStorage.setItem('fcf_cart', JSON.stringify(cart));
        }

        function updateCartUI() {
            const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const delivery = branding.deliveryFee || 0;
            const grandTotal = subtotal + delivery;

            // Badges
            document.getElementById('cart-badge').innerText = totalItems;

            // Drawer Items
            const itemsContainer = document.getElementById('cart-items-list');
            if (cart.length === 0) {
                itemsContainer.innerHTML = `
                    <div class="py-12 text-center text-gray-500 space-y-2">
                        <i class="fa-solid fa-basket-shopping text-4xl text-zinc-700"></i>
                        <p class="text-sm">Your shopping cart is empty.</p>
                    </div>
                `;
            } else {
                itemsContainer.innerHTML = cart.map(item => `
                    <div class="bg-zinc-900 border border-zinc-800 p-3 rounded-xl flex items-center justify-between text-xs">
                        <div class="space-y-1">
                            <p class="font-bold text-white text-sm">${item.name}</p>
                            <p class="text-amber-400 font-medium">${item.size !== 'Standard' ? item.size + ' • ' : ''}Rs. ${item.price}</p>
                        </div>

                        <!-- Quantity Controls -->
                        <div class="flex items-center gap-2 bg-zinc-800 rounded-lg p-1">
                            <button onclick="updateCartQty('${item.cartKey}', -1)" class="w-6 h-6 rounded bg-zinc-700 text-white font-bold hover:bg-amber-500 hover:text-black">-</button>
                            <span class="font-bold text-white px-1">${item.qty}</span>
                            <button onclick="updateCartQty('${item.cartKey}', 1)" class="w-6 h-6 rounded bg-zinc-700 text-white font-bold hover:bg-amber-500 hover:text-black">+</button>
                        </div>
                    </div>
                `).join('');
            }

            // Totals
            document.getElementById('cart-subtotal').innerText = `Rs. ${subtotal}`;
            document.getElementById('cart-delivery-fee').innerText = `Rs. ${delivery}`;
            document.getElementById('cart-grand-total').innerText = `Rs. ${grandTotal}`;
        }

        function toggleCartModal(forceOpen = false) {
            const modal = document.getElementById('cart-modal');
            if (forceOpen) {
                modal.classList.remove('hidden');
            } else {
                modal.classList.toggle('hidden');
            }
        }

        function openCheckoutModal() {
            if (cart.length === 0) {
                alert("Please add at least one food item to your cart before checking out!");
                return;
            }
            toggleCartModal(false);

            // Populate checkout summary
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const delivery = branding.deliveryFee || 0;
            const grandTotal = subtotal + delivery;

            document.getElementById('checkout-summary-items').innerHTML = cart.map(i => `
