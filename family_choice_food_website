            if (type === 'sized') {
                document.getElementById('price-single-block').classList.add('hidden');
                document.getElementById('price-sized-block').classList.remove('hidden');
            } else {
                document.getElementById('price-single-block').classList.remove('hidden');
                document.getElementById('price-sized-block').classList.add('hidden');
            }
        }

        function handleSaveProduct(e) {
            e.preventDefault();

            const id = document.getElementById('prod-id').value || Date.now().toString();
            const name = document.getElementById('prod-name').value.trim();
            const category = document.getElementById('prod-category').value;
            const type = document.getElementById('prod-pricetype').value;
            const desc = document.getElementById('prod-desc').value.trim();
            const image = document.getElementById('prod-image-url').value.trim() || 'https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=600&q=80';
            const available = document.getElementById('prod-available').checked;

            let newItem = { id, name, category, type, desc, image, available };

            if (type === 'sized') {
                newItem.priceRegular = Number(document.getElementById('prod-price-regular').value) || 0;
                newItem.priceLarge = Number(document.getElementById('prod-price-large').value) || 0;
            } else {
                newItem.price = Number(document.getElementById('prod-price-single').value) || 0;
            }

            const existingIndex = products.findIndex(p => p.id === id);
            if (existingIndex > -1) {
                products[existingIndex] = newItem;
            } else {
                products.push(newItem);
            }

            saveProductsState();
            closeProductModal();
            renderAdminProductsTable();
            renderCategories();
            renderMenu();
        }

        function saveProductsState() {
            localStorage.setItem('fcf_products', JSON.stringify(products));
        }

        // Render Admin Orders Log
        function renderAdminOrders() {
            const container = document.getElementById('admin-orders-list');
            if (ordersLog.length === 0) {
                container.innerHTML = `<p class="text-gray-500 text-sm py-6 text-center">No recent local WhatsApp orders recorded.</p>`;
                return;
            }

            container.innerHTML = ordersLog.map(ord => `
                <div class="bg-zinc-900 border border-zinc-800 p-4 rounded-xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-xs">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <span class="font-bold text-amber-400 font-mono text-sm">${ord.id}</span>
                            <span class="text-gray-400">• ${ord.date}</span>
                        </div>
                        <p class="font-bold text-white text-sm">${ord.customer} (${ord.phone})</p>
                        <p class="text-gray-400">${ord.items.map(i => `${i.qty}x ${i.name}`).join(', ')}</p>
                    </div>

                    <div class="flex items-center gap-4">
                        <span class="font-bold text-white text-sm">Rs. ${ord.total}</span>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30">
                            WhatsApp Handed Off
                        </span>
                    </div>
                </div>
            `).join('');
        }

        function clearOrdersLog() {
            if (confirm("Clear local order history?")) {
                ordersLog = [];
                localStorage.removeItem('fcf_orders');
                renderAdminOrders();
            }
        }

        // Branding Management
        function populateBrandingForm() {
            document.getElementById('brand-input-name').value = branding.name;
            document.getElementById('brand-input-tagline').value = branding.tagline;
            document.getElementById('brand-input-hero-title').value = branding.heroTitle;
            document.getElementById('brand-input-hero-desc').value = branding.heroDesc;
            document.getElementById('brand-input-phone').value = branding.phone;
            document.getElementById('brand-input-delivery').value = branding.deliveryFee;
        }

        function saveBrandingSettings(e) {
            e.preventDefault();
            branding.name = document.getElementById('brand-input-name').value.trim();
            branding.tagline = document.getElementById('brand-input-tagline').value.trim();
            branding.heroTitle = document.getElementById('brand-input-hero-title').value.trim();
            branding.heroDesc = document.getElementById('brand-input-hero-desc').value.trim();
            branding.phone = document.getElementById('brand-input-phone').value.trim();
            branding.deliveryFee = Number(document.getElementById('brand-input-delivery').value) || 0;

            localStorage.setItem('fcf_branding', JSON.stringify(branding));
            applyBranding();
            alert("Branding settings saved successfully!");
        }

        function previewLogoUpload(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    branding.logoUrl = evt.target.result;
                };
                reader.readAsDataURL(file);
            }
        }

        function restoreDefaultBranding() {
            if (confirm("Restore default Family Choice Food branding settings?")) {
                branding = { ...defaultBranding };
                localStorage.setItem('fcf_branding', JSON.stringify(branding));
                applyBranding();
                populateBrandingForm();
            }
        }

        // Social Media Settings
        function populateSocialForm() {
            document.getElementById('social-input-instagram').value = socialLinks.instagram || "";
            document.getElementById('social-input-facebook').value = socialLinks.facebook || "";
            document.getElementById('social-input-tiktok').value = socialLinks.tiktok || "";
            document.getElementById('social-input-youtube').value = socialLinks.youtube || "";
        }

        function saveSocialSettings(e) {
            e.preventDefault();
            socialLinks.instagram = document.getElementById('social-input-instagram').value.trim();
            socialLinks.facebook = document.getElementById('social-input-facebook').value.trim();
            socialLinks.tiktok = document.getElementById('social-input-tiktok').value.trim();
            socialLinks.youtube = document.getElementById('social-input-youtube').value.trim();

            localStorage.setItem('fcf_social', JSON.stringify(socialLinks));
            renderSocialLinks();
            alert("Social links updated!");
        }

        function renderSocialLinks() {
            const container = document.getElementById('social-media-container');
            let html = '';

            if (socialLinks.instagram) {
                html += `<a href="${socialLinks.instagram}" target="_blank" class="p-3 rounded-full bg-zinc-900 border border-zinc-800 text-pink-500 hover:scale-110 transition-transform"><i class="fa-brands fa-instagram text-xl"></i></a>`;
            }
            if (socialLinks.facebook) {
                html += `<a href="${socialLinks.facebook}" target="_blank" class="p-3 rounded-full bg-zinc-900 border border-zinc-800 text-blue-500 hover:scale-110 transition-transform"><i class="fa-brands fa-facebook text-xl"></i></a>`;
            }
            if (socialLinks.tiktok) {
                html += `<a href="${socialLinks.tiktok}" target="_blank" class="p-3 rounded-full bg-zinc-900 border border-zinc-800 text-white hover:scale-110 transition-transform"><i class="fa-brands fa-tiktok text-xl"></i></a>`;
            }
            if (socialLinks.youtube) {
                html += `<a href="${socialLinks.youtube}" target="_blank" class="p-3 rounded-full bg-zinc-900 border border-zinc-800 text-red-500 hover:scale-110 transition-transform"><i class="fa-brands fa-youtube text-xl"></i></a>`;
            }

            if (!html) {
                container.innerHTML = `<p class="text-xs text-gray-500">No social media links configured yet.</p>`;
            } else {
                container.innerHTML = html;
            }
        }

        function changeAdminPassword(e) {
            e.preventDefault();
            const n = document.getElementById('new-admin-pass').value;
            const c = document.getElementById('confirm-admin-pass').value;

            if (n !== c) {
                alert("Passwords do not match!");
                return;
            }

            adminPassword = n;
            localStorage.setItem('fcf_admin_pass', adminPassword);
            alert("Admin password changed successfully!");
            e.target.reset();
        }

        function toggleMobileNav() {
            document.getElementById('mobile-nav').classList.toggle('hidden');
        }
    </script>
</body>
</html>
