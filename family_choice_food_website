        // WhatsApp Checkout Submission Hand-off
        function handleCheckoutSubmit(e) {
            e.preventDefault();

            const name = document.getElementById('cust-name').value.trim();
            const phone = document.getElementById('cust-phone').value.trim();
            const orderType = document.getElementById('cust-ordertype').value;
            const address = document.getElementById('cust-address').value.trim();
            const instructions = document.getElementById('cust-instructions').value.trim();
            const payment = document.getElementById('cust-payment').value;

            if (!name || !phone) {
                alert("Please fill in required fields.");
                return;
            }

            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const delivery = branding.deliveryFee || 0;
            const grandTotal = subtotal + delivery;

            // Generate Formatted Order Text
            let msg = `*NEW ORDER - ${branding.name.toUpperCase()}*\n`;
            msg += `-----------------------------------\n`;
            msg += `*Customer:* ${name}\n`;
            msg += `*Phone:* ${phone}\n`;
            msg += `*Order Type:* ${orderType}\n`;
            if (orderType === 'Delivery') {
                msg += `*Address:* ${address}\n`;
            }
            if (instructions) {
                msg += `*Instructions:* ${instructions}\n`;
            }
            msg += `*Payment:* ${payment}\n`;
            msg += `-----------------------------------\n`;
            msg += `*ORDER ITEMS:*\n`;

            cart.forEach(item => {
                msg += `• ${item.qty}x ${item.name} (${item.size}) @ Rs. ${item.price} = Rs. ${item.price * item.qty}\n`;
            });

            msg += `-----------------------------------\n`;
            msg += `*Subtotal:* Rs. ${subtotal}\n`;
            msg += `*Delivery Fee:* Rs. ${delivery}\n`;
            msg += `*GRAND TOTAL:* Rs. ${grandTotal}\n`;
            msg += `-----------------------------------\n`;
            msg += `_Sent via Family Choice Food Web App_`;

            // Save to local demonstration orders log
            const newOrderRecord = {
                id: 'FCF-' + Math.floor(1000 + Math.random() * 9000),
                customer: name,
                phone: phone,
                items: cart,
                total: grandTotal,
                date: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
                status: 'Pending'
            };
            ordersLog.unshift(newOrderRecord);
            localStorage.setItem('fcf_orders', JSON.stringify(ordersLog));

            // Launch WhatsApp URL
            const rawPhone = branding.phone.replace(/[^0-9]/g, '');
            const targetPhone = rawPhone.startsWith('0') ? '92' + rawPhone.substring(1) : rawPhone;
            const waUrl = `https://wa.me/${targetPhone}?text=${encodeURIComponent(msg)}`;

            // Clear Cart & Close Modal
            cart = [];
            saveCart();
            updateCartUI();
            closeCheckoutModal();

            // Redirect customer
            window.open(waUrl, '_blank');
        }

