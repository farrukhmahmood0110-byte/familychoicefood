<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title id="page-title">Family Choice Food (FCF) | Fresh • Cheesy • Fire-Baked</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lobster&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            gold: '#FFC107',
                            goldHover: '#E6A100',
                            darkBg: '#0D0D0D',
                            cardBg: '#181818',
                            border: '#2A2A2A',
                            accent: '#282828'
                        }
                    },
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                        handwritten: ['Lobster', 'cursive']
                    }
                }
            }
        }
    </script>
    
    <style>
        /* Custom Styling & Scrollbars */
        body {
            background-color: #0D0D0D;
            color: #E5E7EB;
            font-family: 'Poppins', sans-serif;
            overflow-x: hidden;
        }
        
        /* Custom Golden Glow & Shadows */
        .gold-glow {
            box-shadow: 0 0 15px rgba(255, 193, 7, 0.25);
        }
        .gold-glow-lg {
            box-shadow: 0 0 25px rgba(255, 193, 7, 0.4);
        }
        
        /* Smooth Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0d0d0d;
        }
        ::-webkit-scrollbar-thumb {
            background: #2a2a2a;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #FFC107;
        }

        /* Handwritten Category Heading Utility */
        .font-handwritten {
            font-family: 'Lobster', cursive;
        }

        /* Modal Overlay Effects */
        .modal-backdrop {
            background-color: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(5px);
        }

        /* Card Hover Zoom */
        .product-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(255, 193, 7, 0.15);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-amber-500 selection:text-black">

